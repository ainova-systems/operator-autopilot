# A user service per project: `operator@<project>.service` runs the installed runtime against
# ~/.config/operator/<project>.env, which sets OPERATOR_MANIFEST (and AINOFLOW_API_KEY or
# OPERATOR_ENV_FILE). Install with:
#   cp operator@.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now operator@<project>.service
[Unit]
Description=Operator orchestration runtime for %i
After=network-online.target herdr.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/operator/%i.env
ExecStart=/usr/bin/env operator run
Restart=always
RestartSec=5
# The daemon releases its leader lease on SIGTERM; running jobs are detached and keep running.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=default.target
