{
  "name": "@ainova-systems/operator",
  "version": "0.7.0",
  "description": "A small generic runtime that runs a project's workflow operations - scripts and agent CLIs - on timers and triggers, with its state in Ainoflow.",
  "keywords": [
    "agents",
    "workflow",
    "claude-code",
    "codex",
    "ainoflow",
    "herdr"
  ],
  "homepage": "https://github.com/ainova-systems/operator-autopilot#readme",
  "bugs": {
    "url": "https://github.com/ainova-systems/operator-autopilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainova-systems/operator-autopilot.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "operator": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=4 \"src/**/*.test.ts\"",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
